OPENROUTER_API_KEY=your_openrouter_key_here
# Any OpenRouter model id; ":free" models cost no credits (see openrouter.ai/models)
LLM_MODEL_NAME=qwen/qwen3-next-80b-a3b-instruct:free

# Set model-specific OpenRouter prices (USD per one million tokens).
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# Hybrid retrieval and cross-encoder reranking.
RERANK_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATES=24
# Use "hash" only for offline smoke tests; production defaults to Hugging Face.
EMBEDDING_BACKEND=huggingface

# With no API key, this serves a retrieval-only sample experience.
DEMO_MODE=false
DEMO_MIN_RELEVANCE=0.25
